{
  "tasks": {
    "test": "deno test -A scripts/ opencode/scripts/",
    "fmt": "deno fmt",
    "lint": "deno lint scripts/ opencode/scripts/",
    "check": "deno check scripts/ opencode/scripts/",
    "budget": "deno run --allow-read scripts/skill-budget.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  },
  "fmt": {
    "lineWidth": 100,
    "include": ["scripts/", "opencode/scripts/"],
    "exclude": ["scripts/tests/fixtures/"]
  }
}
