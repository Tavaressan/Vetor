{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "deno run -A \"${CLAUDE_PLUGIN_ROOT}/scripts/safety-check.ts\"",
            "timeout": 300
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run -A \"${CLAUDE_PLUGIN_ROOT}/scripts/prepare-worktree.ts\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
